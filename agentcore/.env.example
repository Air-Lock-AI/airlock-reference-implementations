# Airlock org MCP URL — the same URL the agent's tool loop talks to.
# Both the cold-start `export_agent` call and every per-invocation tool call go
# through this endpoint, authenticated with the same service token.
AIRLOCK_MCP_URL=https://mcp.air-lock.ai/org/acme

# Name of the agent to load (must exist in the Airlock control room)
AIRLOCK_AGENT_NAME=triage

# Service-token secret in AWS Secrets Manager that the runtime reads at cold start.
# Stored as plain string. Create one with:
#   aws secretsmanager create-secret \
#     --name airlock/agentcore-reference/service-token \
#     --secret-string "$AIRLOCK_SERVICE_TOKEN"
AIRLOCK_TOKEN_SECRET_ARN=arn:aws:secretsmanager:us-west-2:123456789012:secret:airlock/agentcore-reference/service-token

# Region for both the Bedrock AgentCore runtime AND the Secrets Manager entry.
# Must be a region with Bedrock + AgentCore Runtime available.
AWS_REGION=us-west-2

# Only used by scripts/export-agent.ts (build-time pattern). Local-machine secret —
# never bake this into the deployed artifact.
AIRLOCK_SERVICE_TOKEN=
